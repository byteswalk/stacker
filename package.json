{
  "name": "stacker",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "ext:build": "vite build -c extension/vite.config.ts && vite build -c extension/vite.content.config.ts",
    "ext:zip": "npm run ext:build && node extension/scripts/zip.mjs",
    "clean:rust-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-rust-dev-cache.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows.ps1"
  },
  "dependencies": {
    "@tabler/icons-webfont": "^3.44.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "2.8.0",
    "idb": "^8.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.7"
  }
}
